<configuration>
    <!-- Names each run's log file after the moment the server started. -->
    <timestamp key="started" datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <!-- Each line's tag, INF, WRN, ERR, DBG, CHT or CMD, and its colour, the grey of its time, and words in backticks highlighted. -->
    <conversionRule conversionWord="tag" converterClass="org.koremc.TagConverter"/>
    <conversionRule conversionWord="colouredTag" converterClass="org.koremc.ColouredTagConverter"/>
    <conversionRule conversionWord="grey" converterClass="org.koremc.GreyConverter"/>
    <conversionRule conversionWord="highlightedMessage" converterClass="org.koremc.HighlightedMessageConverter"/>
    <conversionRule conversionWord="plainMessage" converterClass="org.koremc.PlainMessageConverter"/>

    <!--
        What's happening, without the detail, which the file has, unless kore.jsonc asks for it: what each line is, when,
        to the second, and what it says. Written above the line being typed at the console, never into it.
    -->
    <appender name="CONSOLE" class="org.koremc.command.ConsoleLogAppender">
        <encoder>
            <pattern>%colouredTag %grey([%d{dd-MM-yy HH:mm:ss}]) %highlightedMessage%n</pattern>
        </encoder>
    </appender>

    <!--
        Everything, one file per run, to read back after testing: requests, SDP offers,
        connection steps and every packet batch in and out (the org.koremc.packets logger).
    -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/kore-${started}.log</file>
        <encoder>
            <pattern>%tag [%d{dd-MM-yy HH:mm:ss.SSS}] [%thread] %logger{36} - %plainMessage%n</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN"/>
    <logger name="org.koremc" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
